// ---------- Generator & Datasource ----------
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------
enum Role {
  ADMIN
  DOCTOR
  PATIENT
}

enum AccountStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum Gender {
  MALE
  FEMALE
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  REJECTED
  RESCHEDULED
  CANCELLED
  COMPLETED
}

// ---------- Models ----------
model User {
  id          String        @id @default(uuid())
  fullName    String
  email       String        @unique
  gender      Gender?
  password    String
  dateOfBirth DateTime
  role        Role          @default(PATIENT)
  status      AccountStatus @default(PENDING)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  doctor  Doctor?
  patient Patient?

  @@index([createdAt])
}

model Specialty {
  id      Int      @id @default(autoincrement())
  name    String   @unique
  doctors Doctor[]
}

model Doctor {
  // Shared PK with User (strict 1–1)
  id   String @id
  user User   @relation(fields: [id], references: [id], onDelete: Cascade)

  bio              String?
  phone            String?
  license_number   String?  @unique
  experience_years Int?
  education        String?
  languages        String[] @default([]) // Postgres text[]
  photo_url        String?
  clinic_name      String?
  location         String?
  is_active        Boolean  @default(true)

  specialtyId Int
  specialty   Specialty @relation(fields: [specialtyId], references: [id], onDelete: Restrict)

  appointments Appointment[]

  createdAt          DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime             @updatedAt @db.Timestamptz(6)
  DoctorAvailability DoctorAvailability[]

  @@index([specialtyId])
}

model DoctorAvailability {
  id       String @id @default(uuid())
  doctorId String
  doctor   Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  // 0=Sunday, 1=Monday, ..., 6=Saturday
  dayOfWeek Int

  // Minutes since midnight (e.g., 08:00 → 480, 12:00 → 720)
  startTime String
  endTime   String

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([doctorId, dayOfWeek])
  @@map("DoctorAvailability")
}

model Patient {
  // Shared PK with User (strict 1–1)
  id   String @id
  user User   @relation(fields: [id], references: [id], onDelete: Cascade)

  phone            String?
  address          String?
  known_conditions String[] @default([])
  allergies        String[] @default([])
  blood_type       String?
  weight_kg        Float?
  height_cm        Float?

  appointments Appointment[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}

model Appointment {
  id        String   @id @default(uuid())

  doctorId  String
  patientId String
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Restrict)

  
  appointmentDate DateTime @db.Date    
  appointmentTime String                

  status    AppointmentStatus @default(PENDING)
  reason    String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt      @db.Timestamptz(6)

  // Prevent double-book for same doctor/date/time
  @@unique([doctorId, appointmentDate, appointmentTime])

  // Helpful indexes
  @@index([patientId, appointmentDate])
  @@index([doctorId, appointmentDate])
}
